package openworkers:worker@0.2.0;

/// Cron entry point; wasi:http/proxy has no equivalent for it
interface scheduled {
    /// Handle a scheduled event (unix timestamp in ms)
    handle-scheduled: func(scheduled-time: u64);
}

/// Every task the platform runs: cron, chained, sent from a worker or
/// invoked. A host calls it in place of `scheduled` when a guest exports both.
interface task {
    record schedule {
        /// Unix timestamp in ms
        time: u64,
        /// The cron expression that fired, when the scheduler sends one
        cron: option<string>,
    }

    variant task-source {
        schedule(schedule),
        /// The id of the parent task
        chained(string),
        /// The id of the worker that created the task
        worker(string),
        /// Where the invocation came from: "cli", "dashboard", "api"
        invoke(option<string>),
    }

    record task-event {
        task-id: string,
        /// 1 on the first run
        attempt: u32,
        /// JSON text
        payload: option<string>,
        source: option<task-source>,
    }

    /// ok carries the result data as JSON text; err fails the task with that
    /// message
    handle-task: func(event: task-event) -> result<option<string>, string>;
}

/// A guest that only serves HTTP: the standard wasi:http proxy, the
/// environment its bindings are named in, and the platform bindings. Guests
/// needing none of those can target wasi:http/proxy directly and run
/// unmodified.
///
/// wasi is declared at 0.2.0, not at the host's patch level: the declared
/// version is a floor, 0.2.x is semver-compatible, and both wasm-tools and
/// wasmtime resolve these against the newer implementation the host links.
/// Pinning higher only locks out toolchains that lag, TinyGo today.
world fetch-worker {
    include wasi:http/proxy@0.2.0;
    include openworkers:bindings/imports@0.1.0;
    import wasi:cli/environment@0.2.0;
}

/// The WASI 0.3 HTTP guest: the async `wasi:http/handler` export, whose
/// native `stream<u8>` bodies and post-return execution give it what the
/// 0.2 world cannot express - streamed bodies and work that outlives the
/// response. The platform bindings stay at their 0.2-era sync ABI: a sync
/// import is legal in an async world, and the host serves both identically.
///
/// wasi:http is pinned at 0.3.0 exactly, not declared as a floor: 0.3 is
/// pre-release-grade and its patch releases have broken the canonical ABI
/// before, so the host vendors the one revision it implements.
world fetch-worker-v3 {
    import wasi:http/types@0.3.0;
    import wasi:http/client@0.3.0;
    include openworkers:bindings/imports@0.1.0;
    import wasi:cli/environment@0.2.0;

    export wasi:http/handler@0.3.0;
}

/// The cron export on its own; a guest adds it only when it has a handler,
/// because exporting an empty one tells the host it handles cron
world scheduled-only {
    export scheduled;
}

/// The task export on its own, added like `scheduled-only`: only by a guest
/// that has a handler
world task-only {
    export task;
}

/// Full OpenWorkers guest: HTTP, cron and the platform bindings
world worker {
    include fetch-worker;
    include scheduled-only;
}

/// Host-side view of what this runtime adds to wasi:http/proxy: the bindings
/// it links and the cron export it calls. The HTTP side is bound through the
/// wasi:http host implementation.
world worker-host {
    include openworkers:bindings/imports@0.1.0;
    export scheduled;
}

/// Host-side view of the task export. A separate world, so a guest without it
/// still binds `worker-host`.
world task-host {
    export task;
}
